Options -MultiViews
RewriteEngine On

# ── Force HTTPS ───────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── www → non-www (ya non-www → www, ek hi rakhna) ────────
# non-www ke liye (amatir.org):
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ── API calls ko Render backend pe proxy karo ────────────
# (GoDaddy shared hosting pe mod_proxy nahi hota, isliye
#  frontend code seedha Render URL pe hit karta hai — yeh section
#  sirf reference ke liye hai, kaam nahi karega shared hosting pe)

# ── SPA Fallback — React Router ke liye ──────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# ── Browser Caching ───────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML — no cache (always fresh)
  ExpiresByType text/html "access plus 0 seconds"
  # JS/CSS assets (Vite fingerprints them, safe to cache long)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  # Images
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  # PDF
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# ── Gzip Compression ──────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ── Security Headers ──────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
